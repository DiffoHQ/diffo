# Copy to `.env` for local development:  cp .env.example .env
#
# ENV=development makes the server hand agents a CLI that runs from *this
# checkout* (`tsx src/cli.ts`) instead of `npx -y diffo`, so a review you open
# while hacking exercises your working tree rather than the published package.
# Without it, `pnpm dev` runs the dev servers but the skill it installs and the
# commands it prints point at the released CLI.
ENV=development
