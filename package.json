{
  "name": "diffo",
  "version": "0.0.1",
  "description": "Local, live code review for the AI age — read what the agent wrote and send feedback straight back",
  "type": "module",
  "license": "Apache-2.0",
  "author": "DiffoHQ",
  "homepage": "https://github.com/DiffoHQ/diffo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DiffoHQ/diffo.git"
  },
  "bugs": {
    "url": "https://github.com/DiffoHQ/diffo/issues"
  },
  "keywords": [
    "git",
    "diff",
    "code-review",
    "cli",
    "ai"
  ],
  "bin": {
    "diffo": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "skills",
    "plugin.json",
    "NOTICE"
  ],
  "scripts": {
    "build": "vite build && tsdown",
    "build:skill": "tsx scripts/build-skill.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm lint && pnpm docs:build",
    "dev": "pnpm run \"/^dev:(client|server)$/\"",
    "dev:client": "vite",
    "dev:skill": "tsx scripts/build-skill.ts --dev",
    "dev:server": "tsx watch --env-file-if-exists=.env --clear-screen=false src/cli.ts --no-open --foreground -p 4949",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome check --write",
    "prepublishOnly": "pnpm check"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "@tanstack/react-query": "^5.101.4",
    "dompurify": "^3.4.13",
    "hono": "^4.7.6",
    "marked": "^18.0.7",
    "mermaid": "^11.17.0",
    "shiki": "^4.4.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.5.2",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^30.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsdown": "^0.21.7",
    "tsx": "^4.19.4",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vitepress": "^1.6.4",
    "vitest": "^4.0.5"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.18.0"
}
